# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json

# Fase 4.5 -- supabase/migrations/ se regenera desde db/migrations/ en cada
# corrida de CI (scripts/build-supabase-migrations.mjs). db/migrations/
# sigue siendo la fuente de verdad, esto no se commitea.
/supabase/migrations/
/supabase/.temp/
/supabase/.branches/
